{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veritymesh:contracts:tasks:source-revision-processing:1.0",
  "title": "SourceRevisionProcessingTask",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_schema_version": { "const": "1.0" },
    "task_type": { "const": "source_revision.process" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256, "pattern": "^\\S+$" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
    "source_object_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
    "source_revision_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
    "source_zone_key": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^\\S+$" },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content_type": { "type": "string", "minLength": 1, "maxLength": 256 },
    "content_length": { "type": "integer", "minimum": 0 },
    "deadline_at": { "type": "string", "format": "date-time" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "resource_class": { "enum": ["cpu", "memory", "gpu"] }
  },
  "required": [
    "task_schema_version",
    "task_type",
    "task_id",
    "event_id",
    "trace_id",
    "idempotency_key",
    "project_id",
    "source_object_id",
    "source_revision_id",
    "source_zone_key",
    "content_sha256",
    "content_type",
    "content_length",
    "deadline_at",
    "attempt",
    "max_attempts",
    "resource_class"
  ]
}
